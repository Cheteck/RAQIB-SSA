{
  "name": "raqib",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npx concurrently -n runtime,dash -c blue,magenta \"npm run dev:runtime\" \"npm run dev:dashboard\"",
    "build": "tsc -p tsconfig.build.json",
    "start:audit": "npm run build && node dist/scripts/run-audit-001.js",
    "test:freellmapi": "node scripts/test-freellmapi.js",
    "test:audit": "npm run build && node dist/scripts/run-audit-001.js",
    "lint": "echo 'No linter configured yet'",
    "clean": "rimraf dist",
    "test:security": "vitest run tests/security",
    "test": "vitest run",
    "start:runtime": "npm run build && node dist/services/runtime/src/index.js",
    "dev:runtime": "tsx services/runtime/src/index.ts",
    "start:dashboard": "npm run start --workspace=@raqib/dashboard",
    "dev:dashboard": "npm run dev --workspace=@raqib/dashboard",
    "start:all": "npx concurrently -n runtime,dash -c blue,magenta \"npm run start:runtime\" \"npm run start:dashboard\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
